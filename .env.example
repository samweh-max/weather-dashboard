# All core features work without any keys.

# Optional: Met Office Weather DataHub "Site Specific" API key (free tier, registration required).
# Register at https://datahub.metoffice.gov.uk/ and subscribe to the Site Specific Global Spot (free plan).
MET_OFFICE_API_KEY=

# Contact string sent in the User-Agent header to NOAA NWS and MET Norway (both ask for one).
WEATHER_APP_CONTACT=weather-dashboard (contact: you@example.com)

# Where the SQLite database lives (imported datasets + API cache).
WEATHER_DB_PATH=./data/weather.db

# Optional: your own Campbell Scientific station on CampbellON (https://campbellon.com/docs/).
# Keep real values in .env.local (git-ignored) or Codespaces secrets, never in this file.
CAMPBELLON_ORG_ID=
CAMPBELLON_STATION_ID=
# Preferred: a CampbellON service account (keeps working through password changes / SSO).
CAMPBELLON_CLIENT_ID=
CAMPBELLON_CLIENT_SECRET=
# Alternative: your own sign-in (not available if your organisation enforces SSO).
CAMPBELLON_USERNAME=
CAMPBELLON_PASSWORD=
# Optional: station position. When set, the station is only offered for locations within 25 km.
CAMPBELLON_STATION_LAT=
CAMPBELLON_STATION_LON=
# Optional: API host, if your account doesn't use https://campbellon.com
CAMPBELLON_BASE=
