# All core features work without any keys.

# Optional: Met Office Weather DataHub "Site Specific" API key (free tier, registration required).
# Register at https://datahub.metoffice.gov.uk/ and subscribe to the Site Specific Global Spot (free plan).
MET_OFFICE_API_KEY=

# Contact string sent in the User-Agent header to NOAA NWS and MET Norway (both ask for one).
WEATHER_APP_CONTACT=weather-dashboard (contact: you@example.com)

# Where the SQLite database lives (imported datasets + API cache).
WEATHER_DB_PATH=./data/weather.db
